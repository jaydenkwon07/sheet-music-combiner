# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated output (assembled pages/PDFs). Keep the folder, ignore contents.
/output/*
!/output/.gitkeep

# Dropped-in source snippets are user data, not source code.
/input/*
!/input/.gitkeep
CLAUDE.md

# Frontend build artifacts / deps
web/frontend/node_modules
web/frontend/dist

# Local git worktrees used for isolated feature work
/.worktrees/
